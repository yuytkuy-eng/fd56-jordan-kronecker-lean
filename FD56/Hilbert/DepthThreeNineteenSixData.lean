/-! Exact polynomial chains for a nineteen-state, six-row affine witness. -/

noncomputable section
namespace FD56
open Matrix Polynomial
open scoped BigOperators
variable {K : Type*} [Field K]
set_option maxHeartbeats 4000000
set_option maxRecDepth 1000

def nineteenSixM : Matrix (Fin 19) (Fin 19) K[X] :=
  fun i j => if j.val=i.val+1 then 1 else if j.val=i.val+2 then X else 0

def nineteenSixP : Matrix (Fin 6) (Fin 19) K[X] :=
  fun i j => if j.val=3*i.val then 1 else
    if (i.val=0 ∧ j.val=14) ∨ (i.val=1 ∧ j.val=11) ∨
      (i.val=2 ∧ j.val=8) ∨ (i.val=3 ∧ j.val=5) ∨
      (i.val=4 ∧ (j.val=1 ∨ j.val=2)) ∨ (i.val=5 ∧ j.val=0) then X else 0

