theorem thirteenThreeQ4_syzygy_degree :
    ∀ i j, (thirteenThreeQ4Syzygy (K := K) i j).natDegree ≤ thirteenThreeQ4SyzygyDegrees j := by
  have hlen : ∀ i j, (thirteenThreeQ4SyzygyCoefficients i j).length ≤ thirteenThreeQ4SyzygyDegrees j+1 := by
    intro i j
    fin_cases i <;> fin_cases j <;> decide
  intro i j
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [thirteenThreeQ4Syzygy, integerPolynomial_coeff, List.getD_eq_default _ _ (by
    have := hlen i j
    omega)]
  simp

